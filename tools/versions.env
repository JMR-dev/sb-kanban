# Pinned toolchain: the single source of truth for scripts/bootstrap.sh (local
# and CI). Every download is verified against the SHA-256 here. Bump a version
# and its hash together.
#
# Hash sources:
#   lua          https://www.lua.org/ftp/ (sha256 column)
#   luarocks     computed after verifying luarocks-<v>.tar.gz.asc against
#                Hisham Muhammad's key (fpr 8460980B2B79786DE0C7FCC83FD8F43C2BB3C478,
#                https://github.com/hishamhm.gpg)
#   luacheck     sha256 of the GitHub commit archive (stable across downloads
#                when recorded)
#   others       the GitHub release asset `digest`

LUA_VERSION=5.5.1
LUA_SHA256=1c4b4068d67061f2a2231ad2b5422e77acea1487ea9890f6320af614f4373dce

LUAROCKS_VERSION=3.13.0
LUAROCKS_SHA256=245bf6ec560c042cb8948e3d661189292587c5949104677f1eecddc54dbe7e37

STYLUA_VERSION=2.6.0
STYLUA_SHA256=a485f72bbfa22e4642e77a84b5edc2611a5cab7477b34e2e709dd8f78e919895

# luacheck from a master commit: the 1.2.0 release crashes on Lua 5.5
# (lunarmodules/luacheck#147), fixed on master in eea104d (2026-03-16).
LUACHECK_COMMIT=2f764bdcabe8b7c19deadf0e9bb2adc19df1a4c5
LUACHECK_SHA256=25a70a5aa9a3fbc2ae5252bd03fd724c8f210f43a70bbfe19d8e17b66c6da4ba

LUALS_VERSION=3.19.2
LUALS_SHA256=93ad326b10f6c00911dd8c450fa098332dbd8f9f45d1052f5636a2d54479b947

# The SilverBullet server the sb-test and e2e stages run against: 2.12.1 is
# the version the maintainer's SilverBullet Desktop runs.
SILVERBULLET_VERSION=2.12.1
SILVERBULLET_SHA256=0ea5c0575021de354b79bf53fb85f170aca93e228b5593959869ff8841dbb1d3
